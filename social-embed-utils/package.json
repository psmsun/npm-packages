{
  "name": "@prismetic/social-embed-utils",
  "version": "1.2.0",
  "description": "LinkedIn, Instagram and YouTube embed URLs from CMS-pasted snippets, Instagram's crop and height messages, and a YouTube click-to-play web component",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./youtube-cover": {
      "types": "./dist/youtubeCover.d.ts",
      "default": "./dist/youtubeCover.js"
    },
    "./jsx": {
      "types": "./dist/jsx.d.ts",
      "default": "./dist/jsx.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmsun/npm-packages.git",
    "directory": "social-embed-utils"
  },
  "homepage": "https://github.com/psmsun/npm-packages/tree/main/social-embed-utils#readme",
  "bugs": {
    "url": "https://github.com/psmsun/npm-packages/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --typecheck --typecheck.tsconfig tsconfig.typecheck.json",
    "prepublishOnly": "npm test && tsc"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "happy-dom": "20.14.5",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "linkedin",
    "instagram",
    "youtube",
    "embed",
    "iframe",
    "social",
    "cms",
    "strapi",
    "web-component",
    "custom-element"
  ],
  "license": "MIT"
}
