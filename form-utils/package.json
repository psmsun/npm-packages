  "description": "NeverBounce email gating for embedded ActiveCampaign forms \u2014 React 19 / Next 16",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmsun/npm-packages.git",
    "directory": "form-utils"
  },
  "homepage": "https://github.com/psmsun/npm-packages/tree/main/form-utils#readme",
