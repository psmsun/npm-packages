{
  "name": "@prismetic/link-utils",
  "version": "1.0.0",
  "description": "CMS href normalisation for Next.js sites — bare domains, external targets, static-file prefetch",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmsun/npm-packages.git",
    "directory": "link-utils"
  },
  "homepage": "https://github.com/psmsun/npm-packages/tree/main/link-utils#readme",
  "bugs": {
    "url": "https://github.com/psmsun/npm-packages/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "vitest run && tsc"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "url",
    "href",
    "nextjs",
    "cms",
    "strapi",
    "link"
  ],
  "license": "MIT"
}
