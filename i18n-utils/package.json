{
  "name": "@prismetic/i18n-utils",
  "version": "0.3.0",
  "description": "Locale config, locale-aware paths and a React locale provider for Next.js sites with more than one locale — React 18+ / Next 16",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/psmsun/npm-packages.git",
    "directory": "i18n-utils"
  },
  "homepage": "https://github.com/psmsun/npm-packages/tree/main/i18n-utils#readme",
  "bugs": {
    "url": "https://github.com/psmsun/npm-packages/issues"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --typecheck --typecheck.tsconfig tsconfig.typecheck.json",
    "prepublishOnly": "npm test && tsc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "happy-dom": "20.14.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "i18n",
    "locale",
    "hreflang",
    "nextjs",
    "react",
    "strapi"
  ],
  "license": "MIT"
}
